# ============================================================
# .gitignore — مشروع crafts_platform (Django + PostgreSQL)
# ============================================================

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===== البيئة الافتراضية =====
venv/
env/
ENV/
.venv/
/Lib/
/Scripts/
/Include/
/pyvenv.cfg
pip-selfcheck.json

# ===== Django =====
*.log
local_settings.py
/staticfiles/
/static_root/
/media/

# ===== قواعد البيانات (تطوير فقط) =====
# ⚠️ المشروع يستخدم PostgreSQL — لا تُرفع ملفات dump أو backup.
# ⚠️ إذا كنت تشارك بيانات تجريبية، استثنِ الملف بـ !filename

# SQLite (إن استُخدم محليًا)
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# PostgreSQL dump/backup
*.dump
*.sql.gz
*.sql.bz2
*.sql.zip
*.backup
*.bak
pg_dump*
*.pgdump

# PostgreSQL data directories (احتياطي)
pgdata/
postgres-data/
/data/
*.pid

# قواعد بيانات كاملة
*.db
*.db3
*.sqlite

# ===== متغيرات البيئة والأسرار =====
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.json
secret_key.txt
credentials.json

# ===== Docker =====
*.pid
docker-compose.override.yml
.docker/

# ===== ملفات مؤقتة ونسخ احتياطية =====
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ===== IDE / المحررات =====
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ===== نظام التشغيل =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== أدوات إضافية =====
.ipynb_checkpoints/
node_modules/
npm-debug.log*
yarn-error.log*
debug_bundle.txt
